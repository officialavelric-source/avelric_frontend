# ==============================================================================
# AVELRIC Headless Storefront — Environment Configuration Template
# ==============================================================================
# Duplicate this file to .env.local and populate with your store credentials.
# NEVER commit .env or .env.local containing real production credentials.
# ==============================================================================

# Shopify Storefront API
VITE_SHOPIFY_STORE_DOMAIN=your-shop-name.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token

# Shopify Customer Account API (Headless Sales Channel -> Customer Accounts -> Application Credentials)
VITE_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your_customer_account_client_id

# Serverless Database & Media Storage (Used by Vercel Serverless API routes)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/avelric?retryWrites=true&w=majority
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here
